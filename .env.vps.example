# Your server, for scripts/deploy-vps.sh, set-secret.sh, admin-token.sh and
# vps-login.sh. Copy to .env.vps (gitignored) and fill in.
AVORA_VPS_HOST=user@your-server
# Optional: a key file instead of your ssh config/agent.
# AVORA_VPS_KEY=$HOME/.ssh/id_ed25519
# Optional: the owner's clock for routines (IANA name). Default: the server's.
# AVORA_TIMEZONE=America/Sao_Paulo
# Optional: build for another CPU (default arm64).
# AVORA_VPS_ARCH=amd64
