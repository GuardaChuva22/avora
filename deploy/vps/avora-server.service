[Unit]
Description=Avora control plane
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=avora
Group=avora
# AVORA_ADMIN_TOKEN; root:avora 640, created by install.sh.
EnvironmentFile=/etc/avora/avora.env
Environment=AVORA_LISTEN_ADDR=127.0.0.1:3190
# The agents' own folders (agents/<id>), shared with the VPS runtime.
Environment=AVORA_WORKSPACE=/var/lib/avora/work
# Unix socket + peer auth: the database trusts the avora system user, no password.
Environment="AVORA_DATABASE_URL=host=/run/postgresql dbname=avora user=avora"
ExecStart=/opt/avora/bin/avora-server
Restart=always
RestartSec=5
MemoryHigh=192M
MemoryMax=256M

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/avora
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
