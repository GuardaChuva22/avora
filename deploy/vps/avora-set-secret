#!/usr/bin/env bash
# Stores one secret in /etc/avora/avora.env and restarts the server.
# The value is read from stdin so it never appears in process lists or history:
#
#   sudo avora-set-secret NVIDIA_API_KEY < file
#
# Normally run through scripts/set-secret.sh from the PC, which asks for the
# value without echoing it.
set -euo pipefail

NAME="${1:?usage: avora-set-secret NAME < value}"
[[ "$NAME" =~ ^[A-Z][A-Z0-9_]{1,63}$ ]] || { echo "invalid name" >&2; exit 2; }
[ "$NAME" != "AVORA_ADMIN_TOKEN" ] || { echo "the admin token is managed by install.sh" >&2; exit 2; }

IFS= read -r VALUE || true
VALUE="${VALUE%$'\r'}"
[ -n "$VALUE" ] || { echo "empty value" >&2; exit 2; }
[[ "$VALUE" != *[[:space:]]* ]] || { echo "value must not contain spaces" >&2; exit 2; }

ENV=/etc/avora/avora.env
TMP=$(mktemp /etc/avora/.avora.env.XXXXXX)
trap 'rm -f "$TMP"' EXIT
grep -v "^$NAME=" "$ENV" > "$TMP" || true
printf '%s=%s\n' "$NAME" "$VALUE" >> "$TMP"
chown root:avora "$TMP"
chmod 640 "$TMP"
mv "$TMP" "$ENV"
trap - EXIT

systemctl restart avora-server
for _ in $(seq 1 20); do curl -fsS http://127.0.0.1:3190/healthz >/dev/null 2>&1 && break; sleep 1; done
echo "$NAME saved; avora-server restarted ($(systemctl is-active avora-server))"
