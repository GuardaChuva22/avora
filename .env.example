# Avora server (avora-server) configuration. Copy to .env or to
# /etc/avora/avora.env on a Linux server. Only AVORA_ADMIN_TOKEN is required;
# everything else has a sensible default or is turned on from the app.

# ── Server ───────────────────────────────────────────────────────────────
# The admin token the desktop app signs in with (long and random:
# `openssl rand -hex 32`). The installer generates one.
AVORA_ADMIN_TOKEN=
# Where the API listens. Loopback by default: publish it with a TLS proxy
# (tailscale serve, Caddy, nginx). Another address needs AVORA_ALLOW_REMOTE.
AVORA_LISTEN_ADDR=127.0.0.1:8080
# AVORA_ALLOW_REMOTE=true
# Postgres. Without it, state lives in memory and is lost on restart.
# AVORA_DATABASE_URL=postgres://avora@/avora?host=/run/postgresql
# The owner's clock for routines (IANA name). Default: the machine's zone.
# AVORA_TIMEZONE=America/Sao_Paulo
# The key that seals API keys and connected apps. Created if missing.
# Default: /etc/avora/vault.key on Linux, %APPDATA%\avora\vault.key on Windows.
# AVORA_VAULT_KEY_FILE=
# The agents' folders (the tree the server node works in).
# AVORA_WORKSPACE=/var/lib/avora/work
# Minutes a locked action waits for the owner's answer.
# AVORA_APPROVAL_MINUTES=

# ── Models ───────────────────────────────────────────────────────────────
# Usually you add providers in the app (Configurações → Modelos): OpenRouter,
# Anthropic, OpenAI, Gemini, xAI, DeepSeek, Mistral, Groq, Ollama, LM Studio...
# Optionally the server can bring its own, any OpenAI-compatible API:
# AVORA_NATIVE_BASE_URL=https://openrouter.ai/api/v1
# AVORA_NATIVE_MODEL=anthropic/claude-sonnet-4.5
# AVORA_NATIVE_API_KEY=
# AVORA_NATIVE_RPM=0            # client-side requests per minute (0 = no limit)
# Models Claude Code and Codex use when an agent delegates ("" = the CLI's own).
# AVORA_CLAUDE_MODEL=
# AVORA_CODEX_MODEL=
# The Codex model of the research tool ("" = Codex's default).
# AVORA_RESEARCH_MODEL=

# ── Tools and apps (all optional) ────────────────────────────────────────
# Web search through the Brave Search API (otherwise a keyless fallback).
# AVORA_BRAVE_API_KEY=
# Google (Gmail, Drive, Calendar): your own OAuth desktop client.
# AVORA_GOOGLE_CLIENT_ID=
# AVORA_GOOGLE_CLIENT_SECRET=
# AVORA_SPOTIFY_CLIENT_ID=
# AVORA_LINKEDIN_CLIENT_ID=
# AVORA_LINKEDIN_CLIENT_SECRET=
# AVORA_IFOOD_CLIENT_ID=
# AVORA_IFOOD_CLIENT_SECRET=
# AVORA_IFOOD_ENV=producao
# AVORA_NFSE_ENV=producao
